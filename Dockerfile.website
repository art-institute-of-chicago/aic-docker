# Single stage build based on Ubuntu
FROM ubuntu:22.04

LABEL maintainer="AIC"

ARG WWWGROUP=1000
ARG NODE_VERSION=18
ARG POSTGRES_VERSION=16

WORKDIR /var/www/website

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Install system dependencies (same as Sail) + additional packages for utils
RUN apt-get update \
    && apt-get install -y gnupg gosu curl ca-certificates zip unzip git supervisor sqlite3 libcap2-bin libpng-dev python2 dnsutils librsvg2-bin fswatch \
    # Additional packages for utils environment
    && apt-get install -y python3-pip openssh-client software-properties-common \
    && curl -sS 'https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x14aa40ec0831756756d7f66c4f4ea0aae5267a6c' | gpg --dearmor | tee /etc/apt/keyrings/ppa_ondrej_php.gpg > /dev/null \
    && echo "deb [signed-by=/etc/apt/keyrings/ppa_ondrej_php.gpg] https://ppa.launchpadcontent.net/ondrej/php/ubuntu jammy main" > /etc/apt/sources.list.d/ppa_ondrej_php.list \
    && apt-get update \
    && apt-get install -y php8.5-cli php8.5-dev \
       php8.5-pgsql php8.5-sqlite3 php8.5-gd php8.5-imagick \
       php8.5-curl \
       php8.5-imap php8.5-mysql php8.5-mbstring \
       php8.5-xml php8.5-zip php8.5-bcmath php8.5-soap \
       php8.5-intl php8.5-readline \
       php8.5-ldap \
       php8.5-msgpack php8.5-igbinary php8.5-redis php8.5-swoole \
       php8.5-memcached php8.5-pcov php8.5-xdebug \
       php8.5-fpm \
       php8.5-gmp \
    && curl -sLS https://getcomposer.org/installer | php -- --install-dir=/usr/bin/ --filename=composer \
    && curl -fsSL https://deb.nodesource.com/setup_$NODE_VERSION.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g npm \
    && curl -sS https://dl.yarnpkg.com/debian/pubkey.gpg | gpg --dearmor | tee /etc/apt/keyrings/yarn.gpg >/dev/null \
    && echo "deb [signed-by=/etc/apt/keyrings/yarn.gpg] https://dl.yarnpkg.com/debian/ stable main" > /etc/apt/sources.list.d/yarn.list \
    && curl -sS https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor | tee /etc/apt/keyrings/pgdg.gpg >/dev/null \
    && echo "deb [signed-by=/etc/apt/keyrings/pgdg.gpg] http://apt.postgresql.org/pub/repos/apt jammy-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y yarn \
    && apt-get install -y mysql-client \
    && apt-get install -y postgresql-client-$POSTGRES_VERSION \
    # Install PostgreSQL server temporarily to get development headers for pgvector
    && apt-get install -y postgresql-$POSTGRES_VERSION postgresql-server-dev-$POSTGRES_VERSION build-essential \
    # Install pgvector
    && cd /tmp \
    && git clone --branch v0.5.1 https://github.com/pgvector/pgvector.git \
    && cd pgvector \
    && make USE_PGXS=1 PG_CONFIG=/usr/lib/postgresql/$POSTGRES_VERSION/bin/pg_config \
    && make install USE_PGXS=1 PG_CONFIG=/usr/lib/postgresql/$POSTGRES_VERSION/bin/pg_config \
    && cd / \
    && rm -rf /tmp/pgvector \
    # Clean up PostgreSQL server (keep client tools)
    && apt-get remove -y postgresql-$POSTGRES_VERSION postgresql-server-dev-$POSTGRES_VERSION build-essential \
    && apt-get -y autoremove \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Set up the sail user (same as original)
RUN groupadd --force -g $WWWGROUP sail
RUN useradd -ms /bin/bash --no-user-group -g $WWWGROUP -u 1337 sail

# Configure PHP-FPM
RUN sed -i 's/listen = \/run\/php\/php8.5-fpm.sock/listen = 0.0.0.0:9000/' /etc/php/8.5/fpm/pool.d/www.conf
RUN sed -i 's/user = www-data/user = sail/' /etc/php/8.5/fpm/pool.d/www.conf
RUN sed -i 's/group = www-data/group = sail/' /etc/php/8.5/fpm/pool.d/www.conf

RUN echo "memory_limit = 512M" >> /etc/php/8.5/fpm/php.ini
RUN echo "max_execution_time = 300" >> /etc/php/8.5/fpm/php.ini
RUN echo "upload_max_filesize = 100M" >> /etc/php/8.5/fpm/php.ini
RUN echo "post_max_size = 100M" >> /etc/php/8.5/fpm/php.ini
RUN echo "max_file_uploads = 20" >> /etc/php/8.5/fpm/php.ini

# Create PHP-FPM runtime directory
RUN mkdir -p /run/php && chown -R sail:sail /run/php

# Create supervisord config for PHP-FPM
RUN cat > /etc/supervisor/conf.d/supervisord.conf << 'SUPERVISOR_EOF'
[supervisord]
nodaemon=true
user=root
logfile=/var/log/supervisor/supervisord.log
pidfile=/var/run/supervisord.pid

[program:php-fpm]
command=/usr/sbin/php-fpm8.5 -F
user=root
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
autostart=true
autorestart=true
SUPERVISOR_EOF

COPY setup.website.sh /usr/local/bin/setup.website.sh
RUN chmod +x /usr/local/bin/setup.website.sh

# Install emacs for the old guys
RUN apt-get update && apt-get install -y emacs sudo time wget gdebi

EXPOSE 9000

ENTRYPOINT ["setup.website.sh"]
